service vendor.unisoc.keymaster-4-0 /vendor/bin/hw/android.hardware.keymaster@4.0-unisoc.service
    interface android.hardware.keymaster@4.0::IKeymasterDevice default
    class early_hal
    user system
    group system drmrpc
    setenv LD_LIBRARY_PATH /vendor/lib64/m10-keymaster-a10:/vendor/lib64
