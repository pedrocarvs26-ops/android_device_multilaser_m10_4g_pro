<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Flag indicating whether the we have a navbar -->
    <bool name="config_showNavigationBar">true</bool>

    <!-- Flag indicating whether the current device allows automatic brightness adjustment -->
    <bool name="config_automatic_brightness_available">false</bool>

    <!-- Boolean indicating whether the wifi chipset has dual frequency band support -->
    <bool name="config_wifi_dual_band_support">true</bool>

    <!-- Maximum number of connected audio devices -->
    <integer name="config_bluetooth_max_connected_audio_devices">3</integer>

    <!-- Minimum screen brightness setting allowed by power manager -->
    <integer name="config_screenBrightnessSettingMinimum">6</integer>
</resources>
