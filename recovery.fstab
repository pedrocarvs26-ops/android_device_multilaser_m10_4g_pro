# Android fstab file for Multilaser M10 4G Pro (Unisoc SC9863A)

# Dynamic Partitions (Super)
system        /system         ext4    ro,barrier=1    wait,logical,first_stage_mount
vendor        /vendor         ext4    ro,barrier=1    wait,logical,first_stage_mount
product       /product        ext4    ro,barrier=1    wait,logical,first_stage_mount

# Physical Partitions
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/userdata       /data        f2fs    noatime,nosuid,nodev,discard     wait,check,formattable
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/cache          /cache       ext4    noatime,nosuid,nodev             wait,check
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/prodnv         /mnt/vendor  ext4    noatime,nosuid,nodev             wait,check
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/metadata       /metadata    ext4    noatime,nosuid,nodev             wait,check
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/socko          /socko       ext4    noatime,nosuid,nodev             wait,check
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/odmko          /odmko       ext4    noatime,nosuid,nodev             wait,check
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/boot           /boot        emmc    defaults                         defaults
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/recovery       /recovery    emmc    defaults                         defaults
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/dtbo           /dtbo        emmc    defaults                         defaults
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/vbmeta         /vbmeta      emmc    defaults                         defaults
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/vbmeta_system  /vbmeta_system emmc  defaults                         defaults
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/vbmeta_vendor  /vbmeta_vendor emmc  defaults                         defaults
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/super          /super       emmc    defaults                         defaults
/dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/misc           /misc        emmc    defaults                         defaults
/dev/block/platform/soc/soc:ap-ahb/20300000.sdio/mmcblk1p1              /external_sd vfat    defaults                         defaults
